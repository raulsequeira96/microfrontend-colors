# Variables de Entorno - HOST
# Copiar a .env.local para desarrollo local

# ===== DESARROLLO =====
# Descomenta estas líneas para usar desarrollo local
# NODE_ENV=development
# COLORPICKER_URL=http://localhost:3001/remoteEntry.js

# ===== PRODUCCIÓN (DEFAULT) =====
# Por defecto usa las URLs de Netlify
# NODE_ENV=production
# COLORPICKER_URL=https://colorpicker-mf-colors-app.netlify.app/remoteEntry.js
